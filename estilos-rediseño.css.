/* Tema visual DENTAL JG basado en la app Administración */
:root{--djg-teal:#19b9ad;--djg-teal-dark:#087f77;--djg-bg:#101820;--djg-card:#182631;--djg-border:#2a3b4b;--djg-text:#e8f0f6;--djg-muted:#8298aa}
.landing,.login-wrap{min-height:100vh;min-height:100dvh;position:relative;overflow:hidden;display:grid;place-items:center;padding:28px 20px;background:radial-gradient(ellipse at 12% 16%,#173b52 0,transparent 42%),radial-gradient(ellipse at 88% 88%,#064e4b 0,transparent 44%),var(--djg-bg);color:var(--djg-text)}
.landing-content{position:relative;z-index:1;width:min(980px,100%);margin:auto}.landing-brand{text-align:center;margin:0 auto 34px}.landing-brand img{display:block;width:min(400px,82vw);max-height:160px;object-fit:contain;margin:0 auto 22px}.landing-brand>p:first-of-type{color:#19c2b7;font-size:12px;letter-spacing:4px;font-weight:850;margin:0 0 12px}.landing-brand h1{font-size:clamp(26px,5vw,42px);line-height:1.15;margin:0;color:#f0f5fa}.landing-brand h1 span{color:#7f95a8;font-weight:500}.landing-subtitle{font-size:15px;color:#91a5b7;margin:18px 0 0}
.module-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.module-card{display:flex;flex-direction:column;align-items:flex-start;text-align:left;gap:12px;min-height:218px;padding:25px 23px;background:var(--djg-card);border:1px solid var(--djg-border);border-radius:23px;color:var(--djg-text);box-shadow:0 14px 36px #0002;transition:transform .18s,border-color .18s,background .18s;cursor:pointer;font:inherit}.module-card:hover,.module-card:focus-visible{transform:translateY(-3px);border-color:var(--djg-teal);background:#1b303a;outline:none}.module-icon{width:52px;height:52px;display:grid;place-items:center;border-radius:15px;background:#13b8ad1c;color:#1cc4b8;font-size:27px;font-weight:700}.module-title{font-size:18px;font-weight:800;line-height:1.25}.module-desc{font-size:13px;color:#8fa3b4;line-height:1.45}.module-arrow{margin-top:auto;padding-top:7px;color:#19c2b7;font-size:13px;font-weight:800;width:100%}.landing-foot{text-align:center;color:#6f8598;font-size:13px;margin:30px 0 0}
.login-card{width:min(520px,100%);background:var(--djg-card);border:1px solid var(--djg-border);border-radius:28px;padding:clamp(22px,5vw,42px);box-shadow:0 22px 70px #0004;color:var(--djg-text)}.login-card label{color:#dce7ef}.login-card input,.login-card select,.login-card textarea{background:#e8f0ff;color:#121923;border-color:#b8c8dc;border-radius:18px;padding:15px 17px;font-size:15px}.login-card .muted,.login-card small{color:var(--djg-muted)}.login-card .primary{background:linear-gradient(110deg,var(--djg-teal),var(--djg-teal-dark));border-radius:18px;padding:17px;font-size:17px;box-shadow:0 10px 26px #12b8a526}.login-card .eyebrow{color:#19c2b7}
@media(max-width:700px){.landing{padding:34px 18px}.landing-brand{margin-bottom:25px}.landing-brand img{width:min(340px,85vw);max-height:120px;margin-bottom:22px}.landing-brand>p:first-of-type{font-size:11px;letter-spacing:3px}.landing-subtitle{font-size:14px;margin-top:13px}.module-grid{grid-template-columns:1fr;gap:12px}.module-card{min-height:0;display:grid;grid-template-columns:54px minmax(0,1fr);grid-template-rows:auto auto auto;align-items:center;column-gap:14px;row-gap:4px;padding:17px;border-radius:18px}.module-icon{grid-row:1/4;width:48px;height:48px}.module-title{font-size:16px;align-self:end}.module-desc{font-size:12px;align-self:start}.module-arrow{grid-column:2;padding-top:7px}.landing-foot{margin-top:24px}.login-card{padding:24px;border-radius:24px}} que
